{
  "name": "camtrapReport development (R 4.6.1)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "rstudio",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": ["REditorSupport.r"],
      "settings": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false
      }
    }
  }
}
