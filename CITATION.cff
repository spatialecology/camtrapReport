    given-names: Elham
    email: eebrahimi.bio@gmail.com
    orcid: https://orcid.org/0000-0001-5191-9832

repository-code: https://github.com/spatialecology/camtrapReport
url: https://spatialecology.github.io/camtrapReport/

contact:
  - family-names: Ebrahimi
    given-names: Elham
    email: eebrahimi.bio@gmail.com
    orcid: https://orcid.org/0000-0001-5191-9832

keywords:
  - automating-camera-trap-data-reporting
  - camera-traps
  - ecological-reporting
  - modular-r-package
  - reproducible-workflow
  - wildlife-monitoring
